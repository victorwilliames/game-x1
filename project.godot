; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be also edited and cleaned up manually.

config_version=5

[application]

config/name="game-x1"
config/description="3D MOBA Prototype (Stage 0: Web proof and foundation)"
run/main_scene="res://scenes/main.tscn"
run/max_fps=0
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=false
window/vsync/vsync_mode=0

[physics]

3d/physics_engine="Dummy"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[autoload]

PerfBench="*res://scripts/perf_bench.gd"

